@page
@model Wybory.Web.Pages.Komitety.RejestracjaModel
@{
    ViewData["Title"] = "Rejestracja komitetu";
}

<h1>Rejestracja komitetu wyborczego</h1>

@if (Model.Komunikat is not null)
{
    <div class="alert alert-success">@Model.Komunikat</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Formularz.Nazwa"></label>
        <input class="form-control" asp-for="Formularz.Nazwa" />
    </div>
    <div class="mb-3">
        <label class="form-label">Okręgi, w których rejestruje się komitet</label>
        @foreach (var okreg in Model.Okregi)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Formularz.OkregiIds" value="@okreg.Id"
                       checked="@Model.Formularz.OkregiIds.Contains(okreg.Id)" />
                <label class="form-check-label">@okreg.Nazwa</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Zarejestruj komitet</button>
</form>
