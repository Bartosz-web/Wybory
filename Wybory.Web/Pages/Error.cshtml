@page
@model ErrorModel
@{
    ViewData["Title"] = "Błąd";
}

<h1 class="text-danger">Coś poszło nie tak</h1>
<p class="lead">Wystąpił nieoczekiwany błąd podczas przetwarzania żądania.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identyfikator żądania:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    <a class="btn btn-primary w-sm-auto" asp-page="/Index">Wróć na stronę startową</a>
</p>

<p class="text-muted">
    Szczegóły błędu są widoczne wyłącznie w środowisku deweloperskim
    (zmienna <code>ASPNETCORE_ENVIRONMENT</code> ustawiona na <code>Development</code>).
    W środowisku produkcyjnym są celowo ukrywane, żeby nie ujawniać danych z wyjątków.
</p>
