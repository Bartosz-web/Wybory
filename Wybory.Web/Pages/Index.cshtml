@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Start";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
}

@if (Model.WynikiSymulacji is { } symulacja)
{
    <section class="hero full-bleed">
        <div class="hero-inner">
            <span class="hero-badge">
                <span class="hero-badge-dot"></span>
                Symulacja zakończona
            </span>

            <h1 class="hero-title">
                Wyniki <span class="accent">symulacji</span> głosowania
            </h1>

            <p class="hero-subtitle">
                Wygenerowano losowych wyborców, komitety i kandydatów w 3 okręgach (co najmniej 10 kandydatów
                na okręg), oddano losowe głosy i policzono wyniki metodą D'Hondta.
            </p>

            <div class="hero-actions">
                <a class="btn-hero-primary" asp-page="/Wyniki/Index">Podsumowanie zbiorcze</a>
                <a class="btn-hero-outline" asp-page="/Index">Powrót do menu</a>
                <form method="post" asp-page-handler="Symuluj">
                    <button type="submit" class="btn-hero-outline"
                            onclick="return confirm('To wyczyści obecne dane i wygeneruje nowe losowe. Kontynuować?');">
                        Symuluj ponownie
                    </button>
                </form>
            </div>
        </div>
    </section>

    <div class="hero-wyniki">
        @foreach (var wyniki in symulacja)
        {
            <h2>@wyniki.NazwaOkregu — mandatów: @wyniki.LiczbaMandatow — formuła: @wyniki.NazwaFormuly</h2>

            @await Html.PartialAsync("_PanelFrekwencji",
                new Wybory.Web.Pages.Shared.DaneFrekwencji("Frekwencja", wyniki.LiczbaUprawnionych, wyniki.LiczbaGlosow))

            @foreach (var komitet in wyniki.Komitety)
            {
                <partial name="_KartaKomitetu" model="komitet" />
            }
        }
    </div>
}
else
{
    <section class="hero full-bleed">
        <div class="hero-inner">
            <span class="hero-badge">
                <span class="hero-badge-dot"></span>
                System Wyborczy
            </span>

            <h1 class="hero-title">
                Twój <span class="accent">głos</span> ma znaczenie
            </h1>

            <p class="hero-subtitle">
                Rejestr wyborców, komitetów i kandydatów w 3 okręgach wyborczych.
                Bezpieczne głosowanie i przejrzyste zliczanie wyników.
            </p>

            <div class="hero-actions">
                <a class="btn-hero-primary" asp-page="/Glosowanie/Index">Oddaj głos</a>
                <a class="btn-hero-outline" asp-page="/Wyniki/Index">Zobacz wyniki</a>
                <form method="post" asp-page-handler="Symuluj">
                    <button type="submit" class="btn-hero-outline"
                            onclick="return confirm('To wyczyści obecnych wyborców, komitety i kandydatów, i wygeneruje nowe losowe dane. Kontynuować?');">
                        Symuluj głosowanie
                    </button>
                </form>
            </div>

            <div class="hero-stats">
                @foreach (var okreg in Model.Kafelki)
                {
                    <div class="hero-stat-card">
                        <h3>@okreg.Nazwa</h3>
                        <div class="hero-stat-row"><span>Mandatów</span> <strong>@okreg.LiczbaMandatow</strong></div>
                        <div class="hero-stat-row"><span>Wyborców</span> <strong>@okreg.Wyborcow</strong></div>
                        <div class="hero-stat-row"><span>Komitetów</span> <strong>@okreg.Komitetow</strong></div>
                        <div class="hero-stat-row"><span>Kandydatów</span> <strong>@okreg.Kandydatow</strong></div>

                        <div class="hero-stat-frekwencja">
                            @{
                                var szerokosc = okreg.Frekwencja.ToString("0.##", CultureInfo.InvariantCulture);
                                var opisFrekwencji = $"Zagłosowało {okreg.Glosow} z {okreg.Uprawnionych} uprawnionych";
                            }
                            <div class="hero-stat-row">
                                <span>Frekwencja</span>
                                <strong>@okreg.Frekwencja.ToString("0.0")%</strong>
                            </div>
                            <div class="pasek pasek-frekwencja" role="img" aria-label="@opisFrekwencji">
                                <span style="width: @szerokosc%"></span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="skroty">
                <a class="skrot" asp-page="/Wyborcy/Rejestracja">Zarejestruj wyborcę</a>
                <a class="skrot" asp-page="/Komitety/Rejestracja">Zarejestruj komitet</a>
                <a class="skrot" asp-page="/Kandydaci/Rejestracja">Zarejestruj kandydata</a>
                <a class="skrot" asp-page="/Wyborcy/Lista">Lista wyborców</a>
            </div>
        </div>
    </section>
}
