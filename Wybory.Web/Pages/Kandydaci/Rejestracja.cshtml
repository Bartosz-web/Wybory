@page
@model Wybory.Web.Pages.Kandydaci.RejestracjaModel
@{
    ViewData["Title"] = "Rejestracja kandydata";
}

<h1>Rejestracja kandydata</h1>
<p class="text-muted">Kandydat musi być wyborcą z biernym prawem wyborczym i musi zostać przypisany do komitetu
    zarejestrowanego w wybranym okręgu.</p>

@if (Model.Komunikat is not null)
{
    <div class="alert alert-success">@Model.Komunikat</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Wyborca (z biernym prawem wyborczym)</label>
        <select class="form-select" asp-for="Formularz.WyborcaId">
            <option value="0">-- wybierz wyborcę --</option>
            @foreach (var wyborca in Model.UprawnieniWyborcy)
            {
                <option value="@wyborca.Id">@wyborca.Imie @wyborca.Nazwisko (@wyborca.Pesel)</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Komitet</label>
        <select class="form-select" asp-for="Formularz.KomitetId">
            <option value="0">-- wybierz komitet --</option>
            @foreach (var komitet in Model.Komitety)
            {
                <option value="@komitet.Id">@komitet.Nazwa</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Okręg (musi być okręgiem, w którym komitet jest zarejestrowany)</label>
        <select class="form-select" asp-for="Formularz.OkregId">
            <option value="0">-- wybierz okręg --</option>
            @foreach (var okreg in Model.Okregi)
            {
                <option value="@okreg.Id">@okreg.Nazwa</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Formularz.NumerNaLiscie"></label>
        <input class="form-control" type="number" min="1" max="10" asp-for="Formularz.NumerNaLiscie" />
    </div>
    <button type="submit" class="btn btn-primary">Zarejestruj kandydata</button>
</form>
