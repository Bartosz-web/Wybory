@page
@model Wybory.Web.Pages.Kandydaci.ListaModel
@{
    ViewData["Title"] = "Lista kandydatów";
}

<h1>Lista kandydatów</h1>

<form method="get" class="filtry">
    <div>
        <label class="form-label" for="okregId">Okręg</label>
        <select class="form-select" id="okregId" name="okregId">
            <option value="">-- wybierz okręg --</option>
            @foreach (var okreg in Model.Okregi)
            {
                <option value="@okreg.Id" selected="@(Model.OkregId == okreg.Id)">@okreg.Nazwa</option>
            }
        </select>
    </div>
    <div class="filtry-akcja">
        <button type="submit" class="btn btn-primary">Pokaż kandydatów</button>
    </div>
</form>

@if (Model.OkregId is not null)
{
    @if (Model.Komitety.Count == 0)
    {
        <p class="text-muted">W tym okręgu nie zarejestrowano jeszcze żadnych kandydatów.</p>
    }

    <div class="accordion" id="komitetyAccordion">
        @foreach (var komitet in Model.Komitety)
        {
            var kolapsId = $"komitet-{komitet.KomitetId}";
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@kolapsId">
                        <span>@komitet.NazwaKomitetu</span>
                        <span class="text-muted">(@komitet.Kandydaci.Count kandydatów)</span>
                    </button>
                </h2>
                <div id="@kolapsId" class="accordion-collapse collapse" data-bs-parent="#komitetyAccordion">
                    <div class="accordion-body p-2 p-sm-0">
                        <div class="table-responsive">
                            <table class="table tabela-karty">
                                <thead>
                                    <tr>
                                        <th class="kol-waska">Numer na liście</th>
                                        <th>Kandydat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kandydat in komitet.Kandydaci)
                                    {
                                        <tr>
                                            <td class="kol-waska" data-etykieta="Nr na liście">@kandydat.NumerNaLiscie</td>
                                            <td data-etykieta="Kandydat">@kandydat.Wyborca!.Imie @kandydat.Wyborca!.Nazwisko</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
